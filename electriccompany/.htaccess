# Keep directory contents private.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # CodeIgniter's public directory is the only web-accessible directory.
    # The first rule prevents the rewritten request from looping.
    RewriteRule ^public(?:/.*)?$ - [L]
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 public/index.php
</IfModule>

ServerSignature Off
